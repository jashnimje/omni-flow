# Per-repo gitignore - toolchain noise (workspace-hardening 28.1, R33.3/R17.3).
# OS noise and credential patterns come from the global ~/.gitignore_global.

# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
# No trailing slash: tool/link_build_dirs.sh turns these into links outside
# OneDrive, and a link is a file to git.
build
.flutter-plugins
.flutter-plugins-dependencies
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/
**/android/.gradle
.gradle
.kotlin
**/android/local.properties
**/ios/Pods/
**/macos/Pods/
coverage/

# Python (firmware tooling, golden-vector scripts)
__pycache__/
*.py[cod]
.venv/

# Local device data and secrets used by live tests
.omniflow/
*.secrets.json

# Logs and databases
*.log
*.sqlite
*.db

# IDE / editor
.idea/
.vscode/
*.swp
*~

# Temporary files
*.tmp
*.bak

# Board firmware the app flashes, built by packages/omniflow_app/tool/firmware_assets.dart
packages/omniflow_app/assets/firmware/*
!packages/omniflow_app/assets/firmware/README.md
