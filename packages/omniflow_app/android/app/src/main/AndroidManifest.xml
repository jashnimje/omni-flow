<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- LAN control of lights, plugs, boards and hosts. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The multicast lock the service holds so broadcast replies and board
         hellos arrive (MulticastLockBridge). It is also the declared
         permission Android 14 requires before a connectedDevice service can
         start. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The engine runs in a connectedDevice foreground service. Not dataSync:
         Android 15 limits it to 6 hours a day and refuses it at boot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Exact alarms: the watchdog that starts a killed service again (Android
         lets a background app start its service only from an exact alarm),
         and the wake for the next time trigger, so the CPU sleeps between
         them. SCHEDULE_EXACT_ALARM, not USE_EXACT_ALARM: OmniFlow is not an
         alarm clock or a calendar. Android 14 and later leave it off until
         the person turns on Alarms and reminders; until then the service
         keeps the CPU awake while time triggers are armed. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Reading and writing NFC tags (nfc_manager), and the tag intent
         below. Phones without NFC can still install the app. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- Android names the Wi-Fi network only to an app with location access,
         and Wi-Fi places need the name (PhoneSensorsBridge). The app asks for
         it from the phone's menu, never at launch. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The Wi-Fi name reaches the background service only with location
         all the time, so a Wi-Fi place works with the screen off. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Android 17 asks before an app reaches devices on the local network
         (shown as nearby devices). Every light, plug, TV and board is there.
         The app asks on first run and from Settings, Permissions. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- The Fix button of Settings, Running in the background: Android
         stops apps it optimises for battery, which stops automations. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- "A Bluetooth device connects" triggers: Android 12 and later send
         the connect broadcasts only with this, asked for when the person
         picks that trigger. Older phones need the install-time one. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- "An app opens" triggers read the app on screen. The person turns on
         usage access in the system settings from This phone; nothing reads
         it before then. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Phone actions (PhoneActionsBridge). Vibrate and set alarm are granted
         at install. Do Not Disturb and the ringer need Do Not Disturb
         access, which a notification asks for the first time a step needs
         it. Full-screen intents show a "Show a message" step over a locked
         phone; Android 14 and later let the person turn that off. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- "A call rings" triggers read only the call state, never the number,
         and the app asks for it only when such a trigger is picked. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- "A calendar event starts" triggers read the next 24 hours of event
         titles on the phone; only a matching title is sent on. Asked when
         such a trigger is picked. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- No backup: secrets are keystore-bound, so a restored copy on another
         phone cannot be decrypted. -->
    <application
        android:label="OmniFlow"
        android:name=".OmniFlowApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- A notification opens the automation or run it names. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true" />
            <!-- Google Assistant's "open app feature" capability. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="omniflow" android:host="open"/>
            </intent-filter>
            <!-- A tag OmniFlow wrote opens the app even when it is closed,
                 and MainActivity hands the scan to the engine. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="omniflow" android:host="tag" android:pathPrefix="/"/>
            </intent-filter>
            <!-- Any other tag (a blank card, a transit card, a tag another
                 app wrote) also reaches OmniFlow while it is closed, so a
                 tag the engine knows by its UID works with no link on it.
                 Android tries NDEF first, then these. -->
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
            <!-- A board plugged into the phone opens OmniFlow, which sets it
                 up or flashes it over USB. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- flutter_foreground_task's service, which must keep this name. No
             stopWithTask, so it keeps running when the app is swiped away. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />
        <!-- The status bar icon of the always-on service notification. -->
        <meta-data
            android:name="com.jashnm.omniflow_app.SERVICE_ICON"
            android:resource="@drawable/ic_notification" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Run from anywhere. Every run and every answer goes to the engine
             over its private socket. The components that run or answer
             (RunReceiver, AskReceiver, AskActivity, RunShortcutActivity) are
             not exported, so only this app's own pending intents and
             shortcuts reach them. The exported ones are what Android
             requires (the launcher's widget broadcasts and configure step,
             the tile long press, the share sheet), and they only show a
             picker: nothing runs until the person picks. -->
        <receiver android:name=".RunReceiver" android:exported="false" />
        <!-- Keeping automations running (ServiceKeeper.kt): the Start button
             of the "not running" notice, the watchdog alarm, the wake for
             the next time trigger, and the system events after a reboot, an
             update or a grant of Alarms and reminders. None is exported:
             only Android and this app's own pending intents reach them. -->
        <receiver android:name=".StartReceiver" android:exported="false" />
        <receiver android:name=".WatchdogReceiver" android:exported="false" />
        <receiver android:name=".WakeAlarmReceiver" android:exported="false" />
        <receiver android:name=".SystemEventsReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".AskReceiver" android:exported="false" />
        <activity
            android:name=".AskActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/PickerTheme" />
        <!-- A "Show a message" step: full screen until tapped away. -->
        <activity
            android:name=".MessageActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop" />
        <activity
            android:name=".RunShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/PickerTheme" />
        <activity
            android:name=".ShortcutsPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/PickerTheme" />
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/PickerTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TilePickerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/PickerTheme">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:taskAffinity=""
            android:theme="@style/PickerTheme">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".RunWidgetSmall"
            android:exported="true"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>
        <receiver
            android:name=".RunWidgetWide"
            android:exported="true"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wide_info" />
        </receiver>
        <service
            android:name=".RunTile1"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".RunTile2"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".RunTile3"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Bound by the system only, after the person turns on
             notification access for OmniFlow. -->
        <service
            android:name=".NotificationTriggers"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- adb only: AgentBridgeProvider refuses every caller but the
             shell and root users. -->
        <provider
            android:name=".AgentBridgeProvider"
            android:authorities="com.jashnm.omniflow_app.agent"
            android:exported="true" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- App names for "An app opens" triggers and the app picker
             (omniflow/apps in MainActivity), and the home screen, which
             counts as no app. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Phone actions: the text to speech engine, links and the clock
             app's alarms and timers. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
