<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw their own splash: the adaptive icon on the
         app's dark background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/omniflow_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/omniflow_background</item>
    </style>
</resources>
