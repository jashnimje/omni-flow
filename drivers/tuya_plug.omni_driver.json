{
  "schemaVersion": 1,
  "id": "tuya_plug",
  "name": "Tuya smart plug (local, switch on DP 1)",
  "category": "power",
  "icon": "plug",
  "transport": { "type": "tuya", "port": 6668, "version": "3.3" },
  "discovery": [{ "method": "tuya_broadcast", "idSetting": "devId" }],
  "settings": [
    { "key": "devId", "label": "Device id" },
    { "key": "localKey", "label": "Local key", "secret": true },
    { "key": "version", "label": "Tuya protocol version: 3.3 (the default), 3.4 or 3.5" }
  ],
  "setup": ["configure:devId", "secret:localKey", "configure:version?"],
  "statePush": { "jsonPath": "$.dps" },
  "statePoll": { "intervalSeconds": 60, "command": { "cmd": "query" }, "jsonPath": "$.dps" },
  "reliability": { "timeoutMs": 1500, "retries": 1 },
  "capabilities": [
    {
      "id": "power",
      "type": "toggle",
      "label": "Power",
      "command": { "cmd": "control", "dps": { "1": "{{value}}" } },
      "stateJsonPath": "$['1']"
    },
    { "id": "power_use", "type": "sensor", "label": "Power use (tenths of a watt, on plugs that measure it)", "stateJsonPath": "$['19']" },
    { "id": "current", "type": "sensor", "label": "Current (mA)", "stateJsonPath": "$['18']" },
    { "id": "voltage", "type": "sensor", "label": "Voltage (tenths of a volt)", "stateJsonPath": "$['20']" }
  ]
}
